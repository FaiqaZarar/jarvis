# Copy this file to .env and fill in real values. Never commit .env itself.

# Embedding provider API key (hosted embedder, e.g. OpenAI / Voyage)
EMBEDDING_API_KEY=

# Embedding model identifier, exactly as OpenRouter expects it
# (provider/model-name). Not a free config change: the embedding dimension
# this model produces is baked into the sqlite-vec chunk_vectors schema
# (FLOAT[1024], see migrations/0006_embedding_index.sql). Switching to a
# model with a different output dimension requires a new migration and a
# full re-embed, not just changing this value.
EMBEDDING_MODEL=voyageai/voyage-4

# OpenRouter API base URL. Only needed if you're pointing at something
# other than the default (e.g. a proxy) - safe to leave unset otherwise.
EMBEDDING_API_BASE=https://openrouter.ai/api/v1

# Chat model for the organize engine's cluster labelling (J-08), as
# OpenRouter expects it (provider/model-name). Uses EMBEDDING_API_KEY /
# EMBEDDING_API_BASE - no separate key. Only invoked during a re-organize
# (LLM-titling base clusters + naming parent levels), a handful of calls
# per run. Safe to leave unset - defaults to anthropic/claude-haiku-4.5.
ORGANIZE_LLM_MODEL=anthropic/claude-haiku-4.5

# Optional. Log verbosity for every module (get_logger). Defaults to INFO
# if unset; set to DEBUG for verbose pipeline/organize tracing, WARNING to
# quieten a demo.
# JARVIS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Optional connectors. Notion is not implemented yet.
# ---------------------------------------------------------------------

# Notion internal integration token (Bearer)
# NOTION_TOKEN=

# Google Drive OAuth. Create an OAuth client of type "Desktop app" in
# Google Cloud, add yourself as a test user on the consent screen (the MVP
# stays in Testing mode - scope drive.readonly, ~weekly re-consent), and
# put both values here. First run opens a browser once; the token is then
# cached in .google_drive_token.json (gitignored, at <JARVIS_DAEMON_HOME>
# once packaged, next to jarvis.db/the daemon discovery file).
#
# The packaged desktop app bundles one shared client for this
# (jarvis_server.internal.env_config._apply_bundled_google_oauth_client -
# a "Desktop app" OAuth client's secret isn't confidential the way a
# server-side client's would be, so shipping one shared pair with the
# build is this client type's normal use), so a real tester's install
# doesn't need either of these set at all. Only needed here for running
# the CLI (jarvis.cmd.drive_ingest) or the GUI from a source checkout
# without that bundled default compiled in.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Optional services. Leave unset and each one is simply off.
# ---------------------------------------------------------------------

# Anonymous error reports and usage counts (see docs/observability-DESIGN.md).
# Builds from source send nothing unless a PostHog project key is set here.
# JARVIS_POSTHOG_KEY=
# JARVIS_POSTHOG_HOST=https://eu.i.posthog.com
# Turn telemetry off even when a key is configured:
# JARVIS_TELEMETRY=0

# Address of a jarvis_cloud server (sign-in, feedback, error reports to
# GitHub issues). Unset: the app has no sign-in and no feedback button.
# JARVIS_CLOUD_BASE_URL=
