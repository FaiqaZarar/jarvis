# Copy this file to jarvis_cloud/.env and fill in real values. Never
# commit .env itself.

# Postgres connection string. For local dev against the role/dbs this
# repo's Phase 1 setup created:
# postgresql://jarvis_cloud:<password>@127.0.0.1:5432/jarvis_cloud_dev
JARVIS_CLOUD_DATABASE_URL=

# The base URL this server is actually reachable at - used to build the
# link that goes in the magic-link email. Must match wherever this
# process is deployed (e.g. https://api.jarvis.app); defaults to
# http://127.0.0.1:8000 for local dev.
# JARVIS_CLOUD_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Which email provider sends the magic-link email. "console" (default)
# logs the link instead of sending it - useful for local dev. "resend"
# sends via Resend's API (resend.com) - see jarvis_cloud_server/auth/email.py.
# JARVIS_CLOUD_EMAIL_PROVIDER=console

# Only used when JARVIS_CLOUD_EMAIL_PROVIDER=resend. Create a key at
# resend.com/api-keys.
RESEND_API_KEY=

# Only used when JARVIS_CLOUD_EMAIL_PROVIDER=resend. Defaults to Resend's
# shared onboarding@resend.dev sender, which Resend restricts to the
# account owner's own verified address until a real domain is verified -
# any other recipient gets a 403. Swap for a verified address on your own
# domain once one exists (resend.com/domains) to send to anyone.
# RESEND_FROM_EMAIL=onboarding@resend.dev

# GitHub token/repo for opening an issue per feedback report. The token
# needs Issues: write access on the target repo; repo is "owner/name".
GITHUB_TOKEN=
GITHUB_REPO=FaiqaZarar/jarvis

# Optional. Log verbosity (get_logger). Defaults to INFO if unset.
# JARVIS_CLOUD_LOG_LEVEL=INFO
